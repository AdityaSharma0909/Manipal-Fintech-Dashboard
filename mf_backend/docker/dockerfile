# This project's pinned dependencies are more reliable on Python 3.11.
FROM python:3.11-bookworm
# ARG APP_ENV
# RUN echo "APP_ENV::::::::::::::::::::: "
# RUN echo $APP_ENV

#maintainer
LABEL Author="Getafix Technologies Pvt Ltd"

# The enviroment variable ensures that the python output is set straight
# to the terminal with out buffering it first
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        gcc \
        wkhtmltopdf \
        cron \
        curl \
        imagemagick \
        ghostscript \
        fonts-indic \
    && rm -rf /var/lib/apt/lists/*

# Debian Bookworm's default client is PostgreSQL 15, while the database
# container runs PostgreSQL 18. pg_dump must be at least as new as the server.
RUN install -d /usr/share/postgresql-common/pgdg && \
    curl --fail --show-error --silent \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc && \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client-18 && \
    rm -rf /var/lib/apt/lists/*


COPY docker/ImageMagick_policy.xml /etc/ImageMagick-6/policy.xml
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade "pip<25.1" "setuptools<81" wheel
RUN pip install --no-cache-dir --default-timeout=120 --retries=5 -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir --upgrade "setuptools<81" \
    && rm -rf /tmp/requirements.txt \
    && useradd -U app_user \
    && install -d -m 0755 -o app_user -g app_user /app/static

# Set Playwright path and install chromium with required OS dependencies
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN mkdir -p /ms-playwright \
    && playwright install --with-deps chromium \
    && chown -R app_user:app_user /ms-playwright

WORKDIR /app
# Install mc
# RUN wget https://dl.min.io/client/mc/release/linux-amd64/mc -O /usr/bin/mc && \
#     chmod +x /usr/bin/mc
RUN mkdir -p logs/
RUN chown -R app_user:app_user logs
RUN mkdir -p gunicorn_logs/
RUN chown -R app_user:app_user gunicorn_logs
RUN mkdir -p media/
RUN chown -R app_user:app_user media
# RUN mkdir -p db_backup/
# RUN chown -R app_user:app_user db_backup


# Adding below env varaible to not get wkhtmltopdf warnings inside container
RUN chown -R  app_user:app_user /tmp
ENV XDG_RUNTIME_DIR=/tmp


USER app_user:app_user
COPY --chown=app_user:app_user . .
RUN chmod +x docker/*.sh



ENTRYPOINT [ "/bin/bash","docker/entrypoint.sh" ]
CMD [ "docker/start.sh" ]
