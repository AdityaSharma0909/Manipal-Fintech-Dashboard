# Use a minimal Ubuntu image
FROM ubuntu:latest

# Install necessary packages (e.g., cron, PostgreSQL client)
RUN apt-get update && apt-get install -y cron postgresql-client

# Copy your backup script into the container
COPY db_backup/postgres_backup.sh /backup_script

# Add your cron job to the crontab file
RUN echo "0 0 * * * /backup_script/postgres_backup.sh" > /etc/cron.d/postgresql_backup

# Start the cron service
CMD ["cron", "-f"]
