# =============================================================================
# ICICI CRM Backend — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# --- Virtual environments ---
.venv/
venv/
ENV/
env/
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Sensitive environment ---
.env
# Keep the template committed
!.env.example

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# --- Testing ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
test-results/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# --- Mypy ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- Ruff / Black ---
.ruff_cache/

# --- Logs ---
logs/*.log
logs/*.json
!logs/.gitkeep

# --- Docker ---
*.pid

# --- Jupyter ---
.ipynb_checkpoints/

# ICICI Certificates
certs/
*.pem
*.key
*.cer
*.crt
*.p12
*.pfx